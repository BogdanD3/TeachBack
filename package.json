{
  "name": "teachback",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} next dev",
    "build": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma generate && DATABASE_URL=${DATABASE_URL:-file:./dev.db} next build",
    "start": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma generate",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma migrate dev",
    "db:deploy": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma migrate deploy",
    "db:seed": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma db seed",
    "db:reset": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma migrate reset --force",
    "demo:reset": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma migrate deploy && DATABASE_URL=${DATABASE_URL:-file:./dev.db} DEMO_OPENS_IN_MIN=3 prisma db seed",
    "ai:check": "node --env-file-if-exists=.env --import tsx scripts/ai-check.ts"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.66.0",
    "next": "^16.4.4",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@google/genai": false,
    "protobufjs": false
  }
}
